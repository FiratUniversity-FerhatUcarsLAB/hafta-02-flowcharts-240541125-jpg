digraph HastaneRandevuSistemi {
    rankdir=LR;
    node [shape=box, style=filled, color=lightblue];

    // Durumlar
    Giris [label="Giriş Ekranı"];
    GirisBasarili [label="Giriş Başarılı"];
    GirisBasarisiz [label="Giriş Başarısız", color=lightcoral];

    AnaMenu [label="Ana Menü"];
    DoktorListe [label="Doktorları Listele"];
    RandevuAl [label="Randevu Al"];
    SaatSecimi [label="Tarih & Saat Seç"];
    RandevuOlustur [label="Randevu Oluştur"];
    RandevuGoruntule [label="Randevularımı Görüntüle"];
    RandevuIptal [label="Randevu İptal Et"];
    Cikis [label="Çıkış Yap", color=lightgray];
    SistemSonu [label="Sistem Sonu", shape=ellipse, style=filled, color=lightgray];

    // Akışlar
    Giris -> GirisBasarili [label="Doğru bilgiler"];
    Giris -> GirisBasarisiz [label="Hatalı bilgiler"];
    GirisBasarisiz -> SistemSonu;

    GirisBasarili -> AnaMenu;

    AnaMenu -> DoktorListe [label="1"];
    AnaMenu -> RandevuAl [label="2"];
    AnaMenu -> RandevuGoruntule [label="3"];
    AnaMenu -> RandevuIptal [label="4"];
    AnaMenu -> Cikis [label="5"];

    RandevuAl -> DoktorListe [label="Doktor Seçimi"];
    DoktorListe -> SaatSecimi;
    SaatSecimi -> RandevuOlustur [label="Saat Uygun"];
    RandevuOlustur -> AnaMenu;

    RandevuGoruntule -> AnaMenu;
    RandevuIptal -> AnaMenu;
    Cikis -> SistemSonu;
}
